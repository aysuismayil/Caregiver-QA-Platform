{
  "info": {
    "_postman_id": "00000000-0000-4000-8000-000000000001",
    "name": "Marketplace API (Sample QA Collection)",
    "description": "Sample Postman collection showing my API testing approach for a service-booking marketplace. Endpoint paths, IDs, URLs and field names are illustrative and do not match the real API. Tokens are never stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains accessToken and refreshToken\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"accessToken\");",
                  "    pm.expect(body).to.have.property(\"refreshToken\");",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error message is generic (no field-specific hint)\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message.toLowerCase()).to.not.include(\"password\");",
                  "    pm.expect(body.message.toLowerCase()).to.include(\"incorrect\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "BUG-004 repro - reuse token after logout (expected 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/account/booking-history"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"BUG-004: token should be invalid after logout (expect 401)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search providers within radius",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/search?lat={{testLat}}&lng={{testLng}}&radiusMiles=10&service=home_cleaning"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of results\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.results).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "BUG-001 repro - provider at exactly 10.00 mi (should be included)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/search?lat={{testLat}}&lng={{testLng}}&radiusMiles=10"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"BUG-001: boundary provider should be included in results\", function () {",
                  "    const body = pm.response.json();",
                  "    const ids = body.results.map(r => r.providerId);",
                  "    pm.expect(ids).to.include(pm.environment.get(\"providerId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search - negative radius (negative case)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/search?lat={{testLat}}&lng={{testLng}}&radiusMiles=-5"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 for invalid radius\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Create hold on slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout/hold"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Hold has an expiry time\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"expiresAt\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout/confirm"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has expected booking fields\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"bookingId\");",
                  "    pm.expect(body).to.have.property(\"status\");",
                  "    pm.expect(body.status).to.be.oneOf([\"pending_provider_response\", \"confirmed\"]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"bookingId\", pm.response.json().bookingId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm booking - nonexistent slot (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout/confirm"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"SLOT-DOES-NOT-EXIST-9999\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"No stack trace in response body\", function () {",
                  "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"at java.\");",
                  "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"traceback\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "BUG-002 repro - near-simultaneous confirm on same slot (Collection Runner: 2 iterations, 0 ms delay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout/confirm"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"BUG-002: response is success or a clear conflict; results compared across iterations\", function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Iteration result:\", pm.response.code, pm.response.json());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Confirm payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"paymentMethodId\": \"pm_test_sample\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Total charged matches expected calculation\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(String(body.totalCharged)).to.eql(pm.environment.get(\"expectedTotal\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "BUG-003 repro - retry without idempotency key (should not double charge)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"paymentMethodId\": \"pm_test_sample\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response returns 200 (charge accepted)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "console.log(\"Charge ID this run:\", pm.response.json().chargeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment - changed amount from client (security/negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"paymentMethodId\": \"pm_test_sample\",\n  \"amount\": 1.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Charged amount is NOT the client-sent value\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.totalCharged).to.not.eql(1.00);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}